<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TransActiva"
        tools:targetApi="31">

        <!-- Actividades adicionales -->
        <activity
            android:name=".RegistroPedido"
            android:exported="false" />

        <activity
            android:name=".EsperandoProveedor"
            android:exported="false" />

        <activity
            android:name=".SolicitudAceptada"
            android:exported="false" />

        <!-- Pantalla principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Otras actividades existentes -->
        <activity android:name=".Registro" android:exported="false" />
        <activity android:name=".InicioLogin" android:exported="false" />
        <activity android:name=".Login" android:exported="true" />
        <activity android:name=".CarouselActivity" android:exported="false" />
        <activity android:name=".IngresoPin" android:exported="false" />
        <activity android:name=".PagoTarjeta" android:exported="false" />
        <activity android:name=".ConfirmarPago" android:exported="false" />

    </application>
</manifest>
