<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base de la app: Material 2 (correcto) -->
    <style name="Base.Theme.TransActiva" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Puedes personalizar aquí colores si quieres -->
    </style>

    <!-- Tema principal de la app -->
    <style name="Theme.TransActiva" parent="Base.Theme.TransActiva" />

    <!-- Tema del Splash -->
